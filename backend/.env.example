# ============================================================
# FG SALGADOS — Backend de Pagamento PIX (Mercado Pago)
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA envie o .env para o GitHub (ele está no .gitignore).
# ============================================================

# 1) Access Token do Mercado Pago (PRODUÇÃO).
#    Pegue aqui (logado na conta MP do agsdelivery24@gmail.com):
#    https://www.mercadopago.com.br/developers/panel/app
#    -> Suas integrações -> criar/integração -> Credenciais de produção
#    Copie o campo "Access Token" (começa com APP_USR-...).
MP_ACCESS_TOKEN=

# OPCIONAL: use "sandbox" para testar sem dinheiro real.
# MP_ENV=production
# MP_ENV=sandbox

# 2) URL PÚBLICA do servidor que hospeda este backend.
#    Ex: https://fg-salgados-api.onrender.com  (sem barra no final)
#    Serve para o Mercado Pago notificar o webhook de pagamento.
PUBLIC_URL=

# 3) Chave secreta para validar o webhook (autentique as notificações).
#    Gere uma longa:  abra o terminal e rode o comando abaixo:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=

# 4) Endereço do site do cardápio (libera o CORS).
#    Deixe como está se for GitHub Pages.
ALLOWED_ORIGIN=https://Gobato15.github.io

# OPCIONAL: porta. A maioria das plataformas define sozinha via PORT.
PORT=3000
